{
  "compilerOptions": {
    /* Modus: JS einschließen, aber nur Dateien mit // @ts-check aktiv prüfen */
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    /* Zielumgebung */
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Strenge Optionen — bei .ts-Dateien aktiv */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Interoperabilität */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
